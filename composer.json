{
  "name": "bayurifkialghifari/indonesia-multipayment-gateways",
  "description": "Typed Laravel SDK for Midtrans, Xendit, DOKU, Paywuz and iPaymu.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "pestphp/pest": "^3.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Bayurifkialghifari\\Payments\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bayurifkialghifari\\Payments\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bayurifkialghifari\\Payments\\PaymentsServiceProvider"
      ],
      "aliases": {
        "Payments": "Bayurifkialghifari\\Payments\\Facades\\Payments"
      }
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format:check": "pint --test",
    "coverage": "pest --coverage --min=100"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}
